<Page x:Class="DryMartiniMovies.Desktop.Pages.ConnectionsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Connections">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Grid Background="#0d0d1a">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="Hitta kopplingar mellan filmer och personer 🍸"
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="20,24,20,20"/>

        <!-- Sökfält + knapp, vertikalt centrerade -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Sökfält 1 -->
                <Grid Margin="0,0,12,0">
                    <TextBox x:Name="TextBox1"
                             Width="220" Height="36" FontSize="15"
                             Padding="10,0,10,0"
                             Text="{Binding Movie1, UpdateSourceTrigger=PropertyChanged}"
                             />
                    <Popup IsOpen="{Binding ShowHistory1}"
                           PlacementTarget="{Binding ElementName=TextBox1}"
                           Placement="Bottom" StaysOpen="False">
                        <Border MaxHeight="280" MinWidth="220" Background="#2a2a3e" CornerRadius="4">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding UserHistory1}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Command="{Binding DataContext.SaveTmdbId1Command, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="10,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Sökfält 2 -->
                <Grid Margin="0,0,12,0">
                    <TextBox x:Name="TextBox2"
                             Width="220" Height="36" FontSize="15"
                             Padding="10,0,10,0"
                             Text="{Binding Movie2, UpdateSourceTrigger=PropertyChanged}"
                             />
                    <Popup IsOpen="{Binding ShowHistory2}"
                           PlacementTarget="{Binding ElementName=TextBox2}"
                           Placement="Bottom" StaysOpen="False">
                        <Border MaxHeight="280" MinWidth="220" Background="#2a2a3e" CornerRadius="4">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding UserHistory2}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Command="{Binding DataContext.SaveTmdbId2Command, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="10,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <ui:Button Content="Hitta koppling"
                           Command="{Binding FindPathCommand}"
                           Height="36" Padding="16,0"/>
            </StackPanel>

            <!-- Resultat direkt under sökfälten -->
            <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="OrangeRed"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"
                       Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,16">
                <ItemsControl ItemsSource="{Binding MoviePathDto.Steps}" AlternationCount="1000">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=" → " VerticalAlignment="Center" FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center" FontSize="15">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} ({1})">
                                            <Binding Path="Name"/>
                                            <Binding Path="Type"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
