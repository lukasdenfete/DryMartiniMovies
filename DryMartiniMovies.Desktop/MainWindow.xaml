<ui:FluentWindow x:Class="DryMartiniMovies.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:DryMartiniMovies.Desktop"
        xmlns:pages="clr-namespace:DryMartiniMovies.Desktop.Pages"
        xmlns:controls="clr-namespace:DryMartiniMovies.Desktop.Controls"
        mc:Ignorable="d"
        Title="Dry Martini Movies" Height="600" Width="1200">
    <Grid x:Name="RootGrid" Background="#0d0d1a">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0"/>
        <ui:NavigationView x:Name="RootNavigationView" Grid.Row="1">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Connections"
                    Icon="{ui:SymbolIcon Link24}"
                    TargetPageType="{x:Type pages:ConnectionsPage}" />
                <ui:NavigationViewItem
                    Content="Import"
                    Icon="{ui:SymbolIcon ArrowUpload24}"
                    TargetPageType="{x:Type pages:ImportPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <!-- Chat overlay – fixed bottom-right -->
        <controls:ChatOverlay x:Name="ChatOverlay"
                              Grid.Row="1"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Panel.ZIndex="10"
                              Margin="0,0,20,20"
                              Messages="{Binding Messages}"
                              InputText="{Binding InputText, Mode=TwoWay}"/>
    </Grid>
</ui:FluentWindow>