@page "/connections"
@using DryMartiniMovies.Client.Services;
@inject MovieApiService MovieApiService
@rendermode InteractiveServer

<div class="connections-page">
<h1 class="page-title">Hitta kopplingar mellan filmer och personer 🍸</h1>

<div class="search-card">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-sm">
            <label class="form-label">Film eller person</label>
            <div class="autocomplete-wrap">
                <input class="form-control dark-input" type="text" @oninput="e => SearchHistory(userHistory1, movie1 = e.Value.ToString())" value="@movie1" placeholder="t.ex. Robert De Niro" />
                @if (userHistory1.Any())
                {
                    <ul class="autocomplete-list">
                        @foreach (var node in userHistory1)
                        {
                            <li class="autocomplete-item" @onclick="() => SaveTmdbId(node, true)">@node.Name</li>
                        }
                    </ul>
                }
            </div>
        </div>
        <div class="col-12 col-sm">
            <label class="form-label">Film eller person</label>
            <div class="autocomplete-wrap">
                <input class="form-control dark-input" type="text" @oninput="e => SearchHistory(userHistory2, movie2 = e.Value.ToString())" value="@movie2" placeholder="t.ex. Barbie" />
                @if (userHistory2.Any())
                {
                    <ul class="autocomplete-list">
                        @foreach (var node in userHistory2)
                        {
                            <li class="autocomplete-item" @onclick="() => SaveTmdbId(node, false)">@node.Name</li>
                        }
                    </ul>
                }
            </div>
        </div>
        <div class="col-12 col-sm-auto">
            <button class="btn btn-primary w-100" type="button" @onclick="() => FindPath(tmdbId1, tmdbId2, label1, label2)" disabled="@(tmdbId1 == 0 || tmdbId2 == 0)">Hitta koppling</button>
        </div>
    </div>
</div>
@if (errorMessage != null)
{
    <p class="text-muted mt-2">@errorMessage</p>
}
@if (moviePathDto != null)
{
    <div class="path-card">
        <p class="path-length">Koppling hittad på @moviePathDto.Length @(moviePathDto.Length == 1 ? "steg" : "steg")</p>
        <div class="path-chain">
            @for (int i = 0; i < moviePathDto.Steps.Count(); i++)
            {
                var step = moviePathDto.Steps.ElementAt(i);
                @if (step.Type == NodeType.Movie)
                {
                    <div class="path-node path-node--movie">
                        <span class="path-node-label">Film</span>
                        <span class="path-node-name">@step.Name</span>
                    </div>
                }
                else
                {
                    <div class="path-node path-node--person">
                        <span class="path-node-label">@(step.Type == NodeType.Director ? "Regissör" : "Skådespelare")</span>
                        <span class="path-node-name">@step.Name</span>
                    </div>
                }
                @if (i < moviePathDto.Steps.Count() - 1)
                {
                    <div class="path-arrow">→</div>
                }
            }
        </div>
    </div>
}
</div>



@code {
    private string movie1;
    private string movie2;
    private int tmdbId1;
    private int tmdbId2;
    private NodeType label1;
    private NodeType label2;
    private MoviePathDto moviePathDto;
    private string errorMessage;
    private List<GraphSearchDto> userHistory1 = new List<GraphSearchDto>();
    private List<GraphSearchDto> userHistory2 = new List<GraphSearchDto>();

    private async Task SearchHistory(List<GraphSearchDto> results, string query)
    {
        if (string.IsNullOrEmpty(query)) { results.Clear(); return; }
        var result = await MovieApiService.SearchGraphAsync(query);
        results.Clear();
        results.AddRange(result);
    }
    private void SaveTmdbId(GraphSearchDto dto, bool isMovie1)
    {
        if(isMovie1){
            tmdbId1 = dto.TmdbId;
            movie1 = dto.Name;
            label1 = dto.Label;
            userHistory1.Clear();
        }
        else {
            tmdbId2 = dto.TmdbId;
            movie2 = dto.Name;
            label2 = dto.Label;
            userHistory2.Clear();
        } 
    }
    private async Task FindPath(int tmdbId1, int tmdbId2, NodeType label1, NodeType label2)
    {
        moviePathDto = null;
        errorMessage = null;
        var path = await MovieApiService.FindShortestPathAsync(tmdbId1, tmdbId2, label1, label2);
        if (path == null)
            errorMessage = "Kunde inte hitta någon koppling mellan dessa noder.";
        else
            moviePathDto = path;
    }
}