@page "/import"
@rendermode InteractiveServer
@using DryMartiniMovies.Client.Services;
@inject MovieApiService MovieApiService

<h1>Importera filmer 🍸</h1>
<ErrorMessage Message="@errorMessage" />

<div class="import-container">
    @if (!isImporting && result == null)
    {
        <p>Ladda upp din Letterboxd ratings.csv för att importera filmer.</p>
        <InputFile OnChange="HandleFileSelected" accept=".csv" />

        @if (selectedFile != null)
        {
            <p>Vald fil: <strong>@selectedFile.Name</strong></p>
            <p class="text-muted">@totalRows filmer hittades</p>
            <button class="btn btn-primary mt-2" @onclick="ImportFile">Importera</button>
        }
    }

    @if (isImporting)
    {
        <div class="d-flex align-items-center gap-3 mt-3">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mb-0">Importerar @totalRows filmer... (@seconds sekunder)</p>
        </div>
    }

    @if (result != null)
    {
        <div class="result mt-3">
            <h4>Import klar! ✅</h4>
            <p>Importerade: <strong>@result.ImportedCount</strong></p>
            <p>Misslyckades: <strong>@result.FailedCount</strong></p>
            @if (result.Errors.Any())
            {
                <details>
                    <summary>Visa fel</summary>
                    <ul>
                        @foreach (var error in result.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </details>
            }
            <button class="btn btn-secondary mt-3" @onclick="Reset">Importera igen</button>
        </div>
    }
</div>

@code {
    private IBrowserFile? selectedFile;
    private ImportResultDto? result;
    private bool isImporting = false;
    private int seconds = 0;
    private int totalRows = 0;
    private Timer? timer;
    private string? errorMessage;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        totalRows = await CountRowsAsync(selectedFile);
    }

    private async Task<int> CountRowsAsync(IBrowserFile file)
    {
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        int count = -1; // subtract header
        while (await reader.ReadLineAsync() != null) count++;
        return Math.Max(count, 0);
    }

    private async Task ImportFile()
    {
        if (selectedFile == null) return;

        isImporting = true;
        result = null;
        seconds = 0;
        errorMessage = null;

        timer = new Timer(async _ =>
        {
            seconds++;
            await InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var streamContent = new StreamContent(stream);
            content.Add(streamContent, "file", selectedFile.Name);

            result = await MovieApiService.ImportLetterboxdAsync(content);
        }
        catch (Exception ex)
        {
            errorMessage = "Något gick fel vid import. Försök igen.";
        }
        finally
        {
            timer?.Dispose();
            isImporting = false;
        }
    }

    private void Reset()
    {
        selectedFile = null;
        result = null;
        seconds = 0;
        errorMessage = null;
    }
}